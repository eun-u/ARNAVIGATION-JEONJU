# Optional. Defaults to data/processed/jeonju_accessibility_graph.geojson.
NAVI_GRAPH_PATH=data/processed/jeonju_accessibility_graph.geojson

# Optional. Runtime state is ignored by Git.
NAVI_DB_PATH=data/runtime/navi.db

# Optional. Read-only spatial-evaluation candidates. The bundle baseline hash
# must match NAVI_GRAPH_PATH; simulations never update the Graph or SQLite.
NAVI_GRAPH_ENRICHMENT_PATH=data/processed/evaluation/graph_enrichment/candidate_bundle.json

# Local secret issued by Gyeonggi Data Dream. Never commit a real key.
GYEONGGI_DISABLED_FACILITIES_API_KEY=

# Public reference endpoints. The dataset-specific Open API service path must
# be confirmed from the provider specification before a collector is added.
GYEONGGI_OPENAPI_BASE_URL=https://openapi.gg.go.kr
GYEONGGI_DISABLED_FACILITIES_DATASET_URL=https://data.gg.go.kr/portal/data/service/selectServicePage.do?infId=VSSNHR6NY83ZUFTBPS1434786061&infSeq=3
ANYANG_ROADWORK_NOTICE_URL=https://www.anyang.go.kr/main/selectBbsNttList.do?bbsNo=94&key=1737
